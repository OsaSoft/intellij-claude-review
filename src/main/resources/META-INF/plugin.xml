<idea-plugin>
    <id>cloud.osasoft.claudereview</id>
    <name>Claude Code Review</name>
    <vendor>Oscar Hernandez</vendor>
    <description>Review Claude Code changes in a merge-request-style diff viewer with inline comments.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="cloud.osasoft.claudereview.model.ReviewModel"/>
        <diff.DiffExtension implementation="cloud.osasoft.claudereview.ui.ReviewDiffExtension"/>
        <fileEditorProvider implementation="cloud.osasoft.claudereview.editor.ReviewFileEditorProvider"/>
        <notificationGroup id="ClaudeReview" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="cloud.osasoft.claudereview.StartReview"
                class="cloud.osasoft.claudereview.action.StartClaudeReviewAction"
                text="Review Claude Changes"
                description="Open a diff review of all uncommitted changes">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
        </action>
    </actions>
</idea-plugin>
